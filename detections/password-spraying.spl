index=wineventlog host=DC01
| rex field=_raw "<EventID[^>]*>(?<event_id>\d+)</EventID>"
| where event_id="4625"
| rex field=_raw "<Data Name=['\"]TargetUserName['\"]>(?<target_user>[^<]*)</Data>"
| rex field=_raw "<Data Name=['\"]IpAddress['\"]>(?<src_ip>[^<]*)</Data>"
| rex field=_raw "<Data Name=['\"]SubStatus['\"]>(?<sub_status>[^<]*)</Data>"
| where lower(sub_status)="0xc000006a"
| where isnotnull(src_ip) AND src_ip!="" AND src_ip!="-"
| stats count AS failed_events
        dc(target_user) AS unique_users
        values(target_user) AS targeted_users
        min(_time) AS first_seen
        max(_time) AS last_seen
        BY src_ip
| where unique_users>=5
| convert ctime(first_seen) ctime(last_seen)
